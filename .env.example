# Server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
LOG_LEVEL=INFO

# Chiave usata dai client OpenAI/Ollama verso questo router (minimo 16 caratteri)
ROUTER_API_KEY=CAMBIA_QUESTA_CHIAVE_LUNGA_E_CASUALE

# Ollama o LiteLLM sulla VM avviata da Proxmox
UPSTREAM_BASE_URL=http://192.168.1.50:11434
UPSTREAM_HEALTH_PATH=/api/version
# Facoltativo. Esempio: Bearer sk-upstream-secret
UPSTREAM_AUTHORIZATION=
UPSTREAM_CONNECT_TIMEOUT=3
UPSTREAM_WRITE_TIMEOUT=60
UPSTREAM_POOL_TIMEOUT=5

# Proxmox API
PROXMOX_BASE_URL=https://192.168.1.10:8006
PROXMOX_NODE=pve
PROXMOX_VM_TYPE=qemu
PROXMOX_VMID=101
PROXMOX_TOKEN_ID=router@pve!ollama-router
PROXMOX_TOKEN_SECRET=INCOLLA_IL_SECRET
# Meglio true con certificato valido. Per certificato privato: PROXMOX_CA_FILE=/percorso/ca.pem
PROXMOX_VERIFY_TLS=false
PROXMOX_CA_FILE=
PROXMOX_TIMEOUT=10

# Cold start
STARTUP_TIMEOUT=180
STARTUP_POLL_INITIAL=0.5
STARTUP_POLL_MAX=3

# Facoltativo: endpoint POST /gaming/start
GAMING_MAC=AA:BB:CC:DD:EE:FF
GAMING_BROADCAST=192.168.1.255
GAMING_WOL_PORT=9
